<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- allowBackup=false in the manifest; these excludes stay as defense in
         depth if that flag is ever flipped. Secrets live in Keystore-backed
         EncryptedSharedPreferences (FlutterSecureStorage). Profiles/known_hosts
         also use SharedPreferences — never cloud-back them up. -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="FlutterSecureStorage" />
</full-backup-content>
